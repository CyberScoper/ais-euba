[Unit]
Description=AIS PWA (convenient client over ais2.euba.sk)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/ais-pwa
Environment=PORT=4176
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/index.js
# Sessions (and the key that seals a remembered password) live here, outside the repo.
# systemd creates it as 0700 root:root and hands the path over as $STATE_DIRECTORY.
StateDirectory=ais-pwa
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
